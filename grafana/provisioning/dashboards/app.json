{
    "title": "GitHub Notifier — RED Metrics",
    "uid": "github-notifier-red",
    "schemaVersion": 38,
    "refresh": "15s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
        {
            "id": 1,
            "title": "Request Rate (req/s)",
            "type": "timeseries",
            "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum(rate(http_requests_total{route!=\"undefined\"}[1m])) by (route, method)",
                    "legendFormat": "{{method}} {{route}}"
                }
            ]
        },
        {
            "id": 2,
            "title": "Error Rate (req/s)",
            "type": "timeseries",
            "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum(rate(http_requests_total{status_code=~\"4..|5..\", route!=\"undefined\"}[1m])) by (route, status_code)",
                    "legendFormat": "{{status_code}} {{route}}"
                }
            ]
        },
        {
            "id": 3,
            "title": "P95 Request Duration (s)",
            "type": "timeseries",
            "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{route!=\"undefined\"}[1m])) by (le, route))",
                    "legendFormat": "p95 {{route}}"
                }
            ]
        },
        {
            "id": 4,
            "title": "P99 Request Duration (s)",
            "type": "timeseries",
            "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{route!=\"undefined\"}[1m])) by (le, route))",
                    "legendFormat": "p99 {{route}}"
                }
            ]
        },
        {
            "id": 5,
            "title": "Active Subscriptions",
            "type": "stat",
            "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "active_subscriptions"
                }
            ]
        },
        {
            "id": 6,
            "title": "GitHub API Requests Total",
            "type": "stat",
            "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum(github_api_requests_total)"
                }
            ]
        },
        {
            "id": 7,
            "title": "Emails Sent Total",
            "type": "stat",
            "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "sum(emails_sent_total)"
                }
            ]
        },
        {
            "id": 8,
            "title": "Scan Duration P95 (s)",
            "type": "stat",
            "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
            "targets": [
                {
                    "datasource": { "type": "prometheus", "uid": "prometheus" },
                    "expr": "histogram_quantile(0.95, sum(rate(scan_duration_seconds_bucket[5m])) by (le))"
                }
            ]
        }
    ]
}
