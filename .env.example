PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@db:5432/ghnotify

# GitHub API (optional — raises rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=ghp_your_token_here

# Redis
REDIS_URL=redis://redis:6379
REDIS_TTL=600

# SMTP (e.g. Gmail with App Password, Mailtrap for dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="GitHub Notifier <noreply@example.com>"

# Base URL used to build confirm/unsubscribe links in emails
APP_BASE_URL=http://localhost:3000

# Cron schedule (default: every 5 minutes)
CRON_SCHEDULE=*/5 * * * *

# API key for X-API-Key header (leave empty to disable auth in dev)
API_KEY=your_secret_api_key

NODE_ENV=production

# RabbitMQ queue url
RABBITMQ_URL=amqp://localhost:5672

# Password for the 'elastic' user (at least 6 characters)
ELASTIC_PASSWORD=examplepassword

# Password for the 'kibana_system' user (at least 6 characters)
KIBANA_PASSWORD=examplepassword

# Version of Elastic products
STACK_VERSION=9.4.2

# Set the cluster name
CLUSTER_NAME=github-notifier-elastic-cluster

# Set to 'basic' or 'trial' to automatically start the 30-day trial
LICENSE=basic

# Port to expose Elasticsearch HTTP API to the host
ES_PORT=9200

# Port to expose Kibana to the host
KIBANA_PORT=5601

# Increase or decrease based on the available host memory (in bytes)
MEM_LIMIT=2147483648